{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xinqing.local/corpus/schemas/source-registry.schema.json",
  "title": "心晴 · 语料来源登记记录",
  "description": "一份外部或内部资源一行（JSONL）。授权条件不同的资料分文件存放，禁止把 research_only 自动升级为 commercial_ok。v1.0.0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "localPath",
    "author",
    "platform",
    "language",
    "scale",
    "dataType",
    "license",
    "licenseClass",
    "upstream",
    "commercialUse",
    "modification",
    "collectedAt",
    "researchValue",
    "usageStatus",
    "verification",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[A-Z]{3}-\\d{3}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "url": { "type": ["string", "null"], "maxLength": 500 },
    "localPath": { "type": ["string", "null"], "maxLength": 300 },
    "author": { "type": "string", "minLength": 1, "maxLength": 100 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 60 },
    "language": { "type": "string", "minLength": 2, "maxLength": 20 },
    "scale": { "type": "string", "minLength": 1, "maxLength": 40 },
    "dataType": {
      "type": "string",
      "enum": ["访谈", "报道", "影视字幕", "书籍", "论文", "论坛帖", "客服记录", "平台话术", "原创", "其他"]
    },
    "license": { "type": "string", "minLength": 2, "maxLength": 60 },
    "licenseClass": { "type": "string", "enum": ["commercial_ok", "research_only", "restricted"] },
    "upstream": { "type": "string", "maxLength": 200 },
    "commercialUse": { "type": "boolean" },
    "modification": { "type": "boolean" },
    "collectedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "researchValue": { "type": "string", "minLength": 4, "maxLength": 300 },
    "usageStatus": {
      "type": "string",
      "enum": ["reference_only", "draft_cited", "approved_derived", "excluded"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "checkedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
