{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xinqing.local/corpus/schemas/scenario.schema.json",
  "title": "心晴 · AI 情景聊天语料单元",
  "description": "一个情景的完整语料单元：身份、动机、语言、初始情景、多轮对话、分支、情绪、冲突、策略、安全退出、来源许可、审核状态。v1.0.0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "category",
    "basic",
    "counterpart",
    "persona",
    "voice",
    "opening",
    "dialogue",
    "branches",
    "emotionalState",
    "conflict",
    "strategies",
    "safety",
    "sources",
    "review",
    "usage"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/scenarioId" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "$ref": "#/$defs/status" },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "subcategory", "priority"],
      "properties": {
        "code": { "$ref": "#/$defs/categoryCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 20 },
        "subcategory": { "type": "string", "minLength": 1, "maxLength": 30 },
        "priority": { "$ref": "#/$defs/priority" }
      }
    },
    "basic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "oneLine", "context", "difficultyDefault", "difficulties", "durationMinutes", "tags", "locale"],
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 30 },
        "oneLine": { "type": "string", "minLength": 8, "maxLength": 60 },
        "context": { "$ref": "#/$defs/text" },
        "difficultyDefault": { "$ref": "#/$defs/difficulty" },
        "difficulties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/difficulty" }
        },
        "durationMinutes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 12 } },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" }
      }
    },
    "counterpart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "relation", "ageBand", "powerDistance", "setting", "userRole"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 20 },
        "relation": { "type": "string", "minLength": 1, "maxLength": 30 },
        "ageBand": { "type": "string", "minLength": 2, "maxLength": 12 },
        "powerDistance": { "type": "string", "minLength": 2, "maxLength": 40 },
        "setting": { "type": "string", "minLength": 2, "maxLength": 80 },
        "userRole": { "type": "string", "minLength": 2, "maxLength": 60 }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traits", "surfaceWant", "underlyingNeed", "fears", "triggers", "coolDowns"],
      "properties": {
        "traits": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 12 } },
        "surfaceWant": { "$ref": "#/$defs/text" },
        "underlyingNeed": { "$ref": "#/$defs/text" },
        "fears": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
        "triggers": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
        "coolDowns": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 40 } }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "sentenceStyle", "verbalTics", "forbidden", "sampleLines"],
      "properties": {
        "register": { "type": "string", "minLength": 2, "maxLength": 40 },
        "sentenceStyle": { "type": "string", "minLength": 2, "maxLength": 60 },
        "verbalTics": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 12 } },
        "forbidden": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 20 } },
        "sampleLines": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 50 } }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "stakes", "userGoalDefault", "openings", "styleNotes"],
      "properties": {
        "scene": { "$ref": "#/$defs/text" },
        "stakes": { "$ref": "#/$defs/text" },
        "userGoalDefault": { "type": "string", "minLength": 6, "maxLength": 60 },
        "openings": { "$ref": "#/$defs/difficultyText" },
        "styleNotes": { "$ref": "#/$defs/difficultyText" }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "turns"],
      "properties": {
        "format": { "type": "string", "minLength": 4, "maxLength": 200 },
        "turns": { "type": "array", "minItems": 4, "maxItems": 24, "items": { "$ref": "#/$defs/turn" } }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/branch" }
    },
    "emotionalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "start", "arc", "end", "deescalation"],
      "properties": {
        "scale": { "const": "1-5" },
        "start": { "$ref": "#/$defs/emotionPoint" },
        "arc": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/emotionPoint" } },
        "end": { "$ref": "#/$defs/emotionPoint" },
        "deescalation": { "$ref": "#/$defs/text" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "initial", "peak", "escalators", "deescalators", "hardLimit"],
      "properties": {
        "scale": { "const": "1-5" },
        "initial": { "type": "integer", "minimum": 1, "maximum": 5 },
        "peak": { "type": "integer", "minimum": 1, "maximum": 5 },
        "escalators": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 50 } },
        "deescalators": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 50 } },
        "hardLimit": { "type": "string", "minLength": 4, "maxLength": 120 }
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/strategy" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitConditions", "stopSignals", "hardStop", "route", "exitLine", "afterExit"],
      "properties": {
        "exitConditions": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 4, "maxLength": 60 } },
        "stopSignals": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 2, "maxLength": 30 } },
        "hardStop": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 4, "maxLength": 60 } },
        "route": { "type": "string", "enum": ["high_risk_protocol", "professional_referral", "no_roleplay"] },
        "exitLine": { "type": "string", "minLength": 4, "maxLength": 80 },
        "afterExit": { "$ref": "#/$defs/text" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "sourceIds", "license", "licenseClass", "attribution", "collectedAt", "notes"],
      "properties": {
        "origin": { "type": "string", "enum": ["original", "adapted", "licensed"] },
        "sourceIds": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceId" } },
        "license": { "type": "string", "minLength": 2, "maxLength": 40 },
        "licenseClass": { "$ref": "#/$defs/licenseClass" },
        "attribution": { "type": "string", "minLength": 2, "maxLength": 200 },
        "collectedAt": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "maxLength": 300 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checklist", "reviewers", "nextReviewAt", "notes"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "checklist": { "$ref": "#/$defs/checklist" },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/reviewer" }
        },
        "nextReviewAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "promptHints", "retrieval"],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["scenario_chat", "ai_chat", "report", "training_only"] }
        },
        "promptHints": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 4, "maxLength": 80 } },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys", "embedding"],
          "properties": {
            "keys": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["category", "subcategory", "intent", "intensity", "strategy", "keyword"] } },
            "embedding": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "scenarioId": { "type": "string", "pattern": "^[A-Z]{3,4}-\\d{3}$" },
    "sourceId": { "type": "string", "pattern": "^SRC-[A-Z]{3}-\\d{3}$" },
    "categoryCode": { "type": "string", "enum": ["FAM", "WRK", "REL", "FRD", "SELF", "CNS", "CARE", "DIG"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "status": { "type": "string", "enum": ["draft", "in_review", "approved", "deprecated", "rejected", "blocked"] },
    "difficulty": { "type": "string", "enum": ["gentle", "realistic", "tough"] },
    "licenseClass": { "type": "string", "enum": ["commercial_ok", "research_only", "restricted"] },
    "text": { "type": "string", "minLength": 4, "maxLength": 600 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "difficultyText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gentle", "realistic", "tough"],
      "properties": {
        "gentle": { "$ref": "#/$defs/text" },
        "realistic": { "$ref": "#/$defs/text" },
        "tough": { "$ref": "#/$defs/text" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "speaker", "text", "emotion", "intensity"],
      "properties": {
        "turn": { "type": "integer", "minimum": 1, "maximum": 24 },
        "speaker": { "type": "string", "enum": ["counterpart", "user_stand_in"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "emotion": { "type": "string", "minLength": 1, "maxLength": 12 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "strategy": { "type": ["string", "null"], "pattern": "^S\\d+$" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "afterTurn", "trigger", "condition", "leadsTo"],
      "properties": {
        "id": { "type": "string", "pattern": "^B\\d+$" },
        "afterTurn": { "type": "integer", "minimum": 1, "maximum": 24 },
        "trigger": { "type": "string", "minLength": 2, "maxLength": 60 },
        "condition": { "type": "string", "minLength": 4, "maxLength": 200 },
        "leadsTo": { "type": "string", "enum": ["continue", "escalate", "deescalate", "exit"] },
        "hint": { "type": "string", "minLength": 2, "maxLength": 120 }
      }
    },
    "emotionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "valence", "arousal"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 12 },
        "valence": { "type": "integer", "minimum": -5, "maximum": 5 },
        "arousal": { "type": "integer", "minimum": 1, "maximum": 5 },
        "atTurn": { "type": "integer", "minimum": 1, "maximum": 24 }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "when", "example", "avoid", "intensity"],
      "properties": {
        "id": { "type": "string", "pattern": "^S\\d+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 20 },
        "when": { "type": "string", "minLength": 4, "maxLength": 120 },
        "example": { "type": "string", "minLength": 4, "maxLength": 160 },
        "avoid": { "type": "string", "minLength": 2, "maxLength": 120 },
        "intensity": { "type": "string", "enum": ["soft", "medium", "firm"] }
      }
    },
    "checkStatus": { "type": "string", "enum": ["pass", "fail", "pending"] },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety", "license", "language", "realism", "bias"],
      "properties": {
        "safety": { "$ref": "#/$defs/checkStatus" },
        "license": { "$ref": "#/$defs/checkStatus" },
        "language": { "$ref": "#/$defs/checkStatus" },
        "realism": { "$ref": "#/$defs/checkStatus" },
        "bias": { "$ref": "#/$defs/checkStatus" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "at"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "enum": ["author", "reviewer", "safety_reviewer", "license_reviewer"] },
        "at": { "$ref": "#/$defs/date" }
      }
    }
  }
}
